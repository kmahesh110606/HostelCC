# Copy to .env.deploy for deployment. For localhost run scripts/setup-local.ps1.
SITE_DOMAIN=hostel.example.edu
SITE_PORT=8080
HOSTELCC_DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.edu
ALLOWED_ORIGINS=https://hostel.example.edu
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=hostel@example.edu
SMTP_PASSWORD=replace-with-provider-app-password
SMTP_FROM=hostel@example.edu
OTP_IP_LIMIT=300
# For EC2, build on your workstation or CI, then use immutable registry tags.
# SERVER_IMAGE=your-registry/hostelcc-server:release-id
# WEB_IMAGE=your-registry/hostelcc-web:release-id
