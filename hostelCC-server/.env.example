# For local development, copy to .env.local and use start-server.ps1.
PORT=8080
COOKIE_SECURE=false
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.edu
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USERNAME=hostel@example.edu
SMTP_PASSWORD=replace-with-provider-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=hostel@example.edu
ALLOWED_ORIGINS=http://localhost:5173
# Optional: PostgreSQL. Omitting DB_URL uses the disposable in-memory H2 database.
# DB_URL=jdbc:postgresql://localhost:5432/hostelcc
# DB_USER=hostelcc
# DB_PASSWORD=replace-with-database-password
